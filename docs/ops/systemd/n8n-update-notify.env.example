# Copy to /etc/alpstein/n8n-update-notify.env (mode 600, root-owned).
# Never commit the live file.

# Required
N8N_UPDATE_NOTIFY_TELEGRAM_BOT_TOKEN=
N8N_UPDATE_NOTIFY_TELEGRAM_CHAT_ID=

# Optional
# GITHUB_TOKEN=
# N8N_UPDATE_NOTIFY_STATE_PATH=/var/lib/alpstein-ops/n8n-update-notify/state.json
# N8N_UPDATE_NOTIFY_CONTAINER=alpstein_n8n_compose
