# Copy to n8n/.env.telegram.customer (gitignored) — customer bot token handoff for T14.2+ only.
# Never commit n8n/.env.telegram.customer.
# Do not put the customer bot token in n8n/.env (owner notify uses TELEGRAM_CHAT_ID there).

# Bot token from client BotFather (one bot per business for MVP)
TELEGRAM_CUSTOMER_BOT_TOKEN=

# Must match businesses.external_id for demo slice
TELEGRAM_CUSTOMER_BUSINESS_EXTERNAL_ID=demo_barbershop_001
