# Alpstein n8n — environment template
# Contract: docs/deployment/deployment-contract.md
# Copy to n8n/.env before first start. Path: <repo>/n8n/.env
# Never commit .env.

# =============================================================================
# REQUIRED — n8n admin and volume encryption
# =============================================================================

# Generate once: openssl rand -hex 32
# Must stay stable across restarts using the same volume (alpstein_n8n_data).
N8N_ENCRYPTION_KEY=

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# =============================================================================
# REQUIRED — backend integration (workflows use $env in HTTP Request nodes)
# =============================================================================

# No trailing slash.
#
# PORTABLE TARGET (B2.7+ — root docker-compose.yml, service DNS on alpstein_internal):
BACKEND_BASE_URL=http://backend:8000
#
# LEGACY Contabo host only (n8n/docker-compose.yml — gateway to host uvicorn :8010):
# BACKEND_BASE_URL=http://172.20.0.1:8010

# MUST match backend/.env — header X-Alpstein-Webhook-Token (not Bearer)
N8N_BACKEND_API_TOKEN=

# =============================================================================
# OPTIONAL — n8n workflow defaults
# =============================================================================

# Test webhook normalize default (Gate 1)
# ALPSTEIN_TEST_BUSINESS_ID=demo_barbershop_001

# Telegram customer ingress default
# ALPSTEIN_TELEGRAM_BUSINESS_ID=alpstein_ai_demo_001

# =============================================================================
# OPTIONAL — T13.5 owner Telegram notify (required for Gate 2 verification)
# =============================================================================

# TELEGRAM_CHAT_ID=
# Bot token: n8n credential "AlpsteinAIbot" (telegramApi) — not in this file

# =============================================================================
# OPTIONAL — T14 customer bot (credential import; see n8n/scripts/)
# =============================================================================

# Copy n8n/.env.telegram.customer.example → n8n/.env.telegram.customer (gitignored)
# Credential name: alpsteinai_0001bot / per telegram-channel-credentials.md

# =============================================================================
# OPTIONAL — timezone
# =============================================================================

GENERIC_TIMEZONE=Europe/Zurich
TZ=Europe/Zurich

# Optional — webhook URL base when testing from host (non-secret)
# WEBHOOK_URL=http://127.0.0.1:15679/

# =============================================================================
# BACKEND-ONLY — do not set in n8n/.env
# =============================================================================
# ALPSTEIN_AI_DATABASE_URL, OPENAI_API_KEY, LANGFUSE_*, ALPSTEIN_AI_ENVIRONMENT

# =============================================================================
# DEPRECATED / LEGACY patterns (B2.0 contract)
# =============================================================================
# Host port 8010 + UFW 172.20.0.0/16 → 8010 — replaced by http://backend:8000 in compose
# DATABASE_URL, ENVIRONMENT, SECRET_KEY — backend naming; not used by n8n
