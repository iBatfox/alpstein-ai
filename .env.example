# Alpstein AI — deployment environment index
# Canonical contract: docs/deployment/deployment-contract.md
# Never commit .env files with real secrets.
#
# Copy this file to .env at repo root for docker-compose (B2.2+ postgres).
# Backend and n8n keep their own .env files (see below).
#
# =============================================================================
# COMPOSE — Postgres (B2.2) — required for docker-compose.yml
# =============================================================================
# Used by root docker-compose.yml only. Not loaded by backend Settings directly.

POSTGRES_DB=alpstein_ai
POSTGRES_USER=alpstein
# REQUIRED for docker-compose (postgres service + ALPSTEIN_AI_DATABASE_URL interpolation).
# If missing, `docker-compose config` / `up` fails. Changing this later does NOT update
# an existing alpstein_postgres_data volume — recreate volume or ALTER USER in Postgres.
POSTGRES_PASSWORD=

# Dev overlay only (docker-compose.dev.yml) — NOT production target
# POSTGRES_HOST_PORT=15433
# BACKEND_HOST_PORT=8000
# N8N_HOST_PORT=15679   # production nginx upstream (default overlay uses 15680)
# LANGFUSE_TRACING_ENABLED=false   # omit or false — empty string breaks backend bool parsing

# Compose CLI (Contabo): use Docker Compose v2 — `docker compose` (space), not legacy
# `docker-compose` v1.29 + Docker 29 → KeyError ContainerConfig on --force-recreate.
# Install: apt install docker-compose-v2

# =============================================================================
# COMPOSE — Backend service (B2.6+) — interpolated into docker-compose.yml
# =============================================================================
# Password in ALPSTEIN_AI_DATABASE_URL is built from POSTGRES_* above (@postgres:5432).
# For host Alembic against dev postgres port, use backend/.env.example instead.

ALPSTEIN_AI_ENVIRONMENT=development
N8N_BACKEND_API_TOKEN=
OPENAI_API_KEY=

# Telegram Mini App BCB bridge — backend-only values passed through compose.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
# Comma-separated numeric Telegram user IDs. Empty denies bridge access.
TELEGRAM_MINI_APP_ALLOWED_USER_IDS=
BCB_TELEGRAM_TENANT_ID=
BCB_TELEGRAM_BUSINESS_ID=

# Optional — Langfuse tracing (compose backend; see backend/.env.example)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Legacy deployments may have LANGFUSE_BASE_URL; compose maps it to LANGFUSE_HOST if LANGFUSE_HOST is unset.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set true only when you want backend Langfuse tracing enabled; use false or omit, never blank.
# LANGFUSE_TRACING_ENABLED=true

# Bootstrap profile only (docker-compose --profile bootstrap) — dev/test seed + SQL
# RUN_SQL_BOOTSTRAP=true
# Refused when ALPSTEIN_AI_ENVIRONMENT is production or staging

# =============================================================================
# BACKEND + N8N — separate files
# =============================================================================
#
#   backend/.env.example  → copy to backend/.env (FastAPI, Alembic, OpenAI)
#   n8n/.env.example      → copy to n8n/.env (n8n runtime, BACKEND_BASE_URL)
#
# ALPSTEIN_AI_DATABASE_URL password must match POSTGRES_PASSWORD above.
#
# Shared secret that MUST match on both sides:
#   N8N_BACKEND_API_TOKEN
#
# Quick start (local, from repo root):
#   cp .env.example .env && cp backend/.env.example backend/.env
#   cp n8n/.env.example n8n/.env
#   # edit — set POSTGRES_PASSWORD, align ALPSTEIN_AI_DATABASE_URL, tokens
#
# Portable target (B2.6+ Docker, not live on legacy host yet):
#   ALPSTEIN_AI_DATABASE_URL=...@postgres:5432/alpstein_ai
#   n8n BACKEND_BASE_URL=http://backend:8000  (see n8n/.env.example; B2.7)
#
# Legacy Contabo host (current production — do not use as clean-clone template):
#   Host uvicorn on port 8010; n8n BACKEND_BASE_URL=http://172.20.0.1:8010
