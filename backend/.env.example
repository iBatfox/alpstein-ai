# Alpstein AI — backend environment template (canonical)
# Contract: docs/deployment/deployment-contract.md
# Copy to backend/.env (or set via compose env_file). Never commit .env.
#
# Run Alembic and uvicorn from backend/ with these variables loaded.

# =============================================================================
# REQUIRED — backend will not serve webhooks correctly without these
# =============================================================================

# PostgreSQL (async SQLAlchemy + Alembic). Driver: postgresql+asyncpg://
# Password must match POSTGRES_PASSWORD in repo root .env (see .env.example).
#
# Compose network (B2.6+ — set via root .env / docker-compose.yml interpolation):
ALPSTEIN_AI_DATABASE_URL=postgresql+asyncpg://alpstein:CHANGE_ME@postgres:5432/alpstein_ai
#
# Host Alembic against dev overlay (127.0.0.1:15433 — docker-compose.dev.yml):
# ALPSTEIN_AI_DATABASE_URL=postgresql+asyncpg://alpstein:CHANGE_ME@127.0.0.1:15433/alpstein_ai

# development | dev | local | test — allows dev-only seed scripts
# production — default in code if unset; blocks dev seed
ALPSTEIN_AI_ENVIRONMENT=development

# Shared with n8n — MUST match n8n/.env exactly (header X-Alpstein-Webhook-Token)
# Empty → webhook returns 403 FORBIDDEN
N8N_BACKEND_API_TOKEN=

# Required for live AI replies (backend only — n8n must not use this)
OPENAI_API_KEY=

# =============================================================================
# Meta / WhatsApp Cloud API (backend webhook intake — see docs/ops/meta-whatsapp-webhook-setup.md)
# =============================================================================

# Meta App → Webhooks → Verify Token (must match GET /webhooks/meta handshake)
META_VERIFY_TOKEN=

# WhatsApp Cloud API credentials (outbound + future processing; not used by verification route)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Instagram Graph API (future channel integration; not used by Meta webhook route)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Instagram → n8n unified ingress dispatch (after Meta webhook persist)
ALPSTEIN_INSTAGRAM_N8N_INGRESS_ENABLED=false
ALPSTEIN_INSTAGRAM_N8N_INGRESS_WEBHOOK_URL=http://n8n:5678/webhook/alpstein/unified-customer-ingress/instagram/incoming
ALPSTEIN_INSTAGRAM_N8N_DISPATCH_TIMEOUT_SECONDS=10

# Instagram outbound DM send (n8n → backend → Meta Send API). Default OFF.
ALPSTEIN_INSTAGRAM_OUTBOUND_ENABLED=false

# =============================================================================
# OPTIONAL — backend (unprefixed; see backend/app/core/config.py)
# =============================================================================

OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT=30

# =============================================================================
# OPTIONAL — ALPSTEIN_AI_ prefixed
# =============================================================================

# ALPSTEIN_AI_SERVICE_NAME=alpstein-ai-backend

# =============================================================================
# OPTIONAL — Langfuse tracing (dev/internal; backend only)
# Auto-enables in development|dev|local|test when keys are set.
# Set LANGFUSE_TRACING_ENABLED=true to force on in production-like envs.
# =============================================================================

# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Runtime code reads LANGFUSE_HOST. If you have a legacy LANGFUSE_BASE_URL value,
# copy it to LANGFUSE_HOST for direct backend runs; compose maps it automatically.
# LANGFUSE_TRACING_ENABLED=false

# =============================================================================
# OPTIONAL — E3.5 rate limiting (default OFF — see docs/ops/ingress-rate-limit-429.md)
# =============================================================================
# ALPSTEIN_AI_RATE_LIMIT_ENABLED=false

# =============================================================================
# OPTIONAL — E3.6 spam protection (default OFF — see docs/ops/ingress-spam-protection.md)
# Keep false until E3.5d + E3.6 staging validation pass.
# Production safe mode (default true) only marks suspicious — no blocking.
# =============================================================================
# ALPSTEIN_AI_SPAM_PROTECTION_ENABLED=false
# ALPSTEIN_AI_SPAM_PRODUCTION_SAFE_MODE=true

# =============================================================================
# DEPRECATED — do not use in new deployments (B2.0 contract)
# =============================================================================
# DATABASE_URL=          → use ALPSTEIN_AI_DATABASE_URL
# ENVIRONMENT=           → use ALPSTEIN_AI_ENVIRONMENT
# SECRET_KEY=            → not implemented in Settings; reserved

# =============================================================================
# LEGACY host runtime (Contabo) — not portable target; see n8n/.env.example
# =============================================================================
# ALPSTEIN_AI_DATABASE_URL=postgresql+asyncpg://...@127.0.0.1:15432/...
# Backend listen port 8010 on host — contract target is container port 8000
